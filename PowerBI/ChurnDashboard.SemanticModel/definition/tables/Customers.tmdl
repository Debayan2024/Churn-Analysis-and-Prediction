table Customers
	lineageTag: 1f96f192-5976-45d1-89ae-e22dda035774

	/// Total Customers
	measure 'Total Customers' = COUNTROWS(Customers)
		formatString: #,0
		displayFolder: Overview
		lineageTag: fbea410e-5033-4125-beb0-98ad70039ba9

	/// Churned Customers
	measure 'Churned Customers' = CALCULATE([Total Customers], KEEPFILTERS(Customers[Churn] = "Yes"))
		formatString: #,0
		displayFolder: Overview
		lineageTag: 9939cb9b-577e-4a49-9ac6-c8701c050d7d

	/// Retained Customers
	measure 'Retained Customers' = CALCULATE([Total Customers], KEEPFILTERS(Customers[Churn] = "No"))
		formatString: #,0
		displayFolder: Overview
		lineageTag: e87c8742-0b98-4e3b-87ef-0ac29aa6631e

	/// Churn Rate
	measure 'Churn Rate' = DIVIDE([Churned Customers], [Total Customers])
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: 91bbd204-8121-433a-b7e9-c8df58049bb9

	/// Share of churners who have this attribute; not the churn rate within that group.
	measure 'Churners with Dependents' = DIVIDE(CALCULATE([Churned Customers], KEEPFILTERS(Customers[Dependents] = "Yes")), [Churned Customers])
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: 519d4ef7-d618-47f9-ac3b-0b5916ac6d01

	/// Share of churners who have this attribute; not the churn rate within that group.
	measure 'Churners with Partner' = DIVIDE(CALCULATE([Churned Customers], KEEPFILTERS(Customers[Partner] = "Yes")), [Churned Customers])
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: 322a1c0a-d961-4d08-867f-55039767d833

	/// Share of churners who have this attribute; not the churn rate within that group.
	measure 'Churners with Senior Citizens' = DIVIDE(CALCULATE([Churned Customers], KEEPFILTERS(Customers[Senior Citizen] = "Yes")), [Churned Customers])
		formatString: 0.00%
		displayFolder: Overview
		lineageTag: 7a779b7f-a4b8-4eb5-bd68-29bf0da1c75a

	/// Average Monthly Charges
	measure 'Average Monthly Charges' = AVERAGE(Customers[MonthlyCharges])
		formatString: #,0.00
		displayFolder: Overview
		lineageTag: 4759d2d4-8317-484c-a566-c98c93928191

	/// Scored Customers
	measure 'Scored Customers' = CALCULATE([Total Customers], KEEPFILTERS(Customers[Prediction Status] = "Scored"))
		formatString: #,0
		displayFolder: Prediction coverage
		lineageTag: 0eccbeac-f28a-47a6-8293-6c5d17ac75e6

	/// Score Coverage
	measure 'Score Coverage' = DIVIDE([Scored Customers], [Total Customers])
		formatString: 0.00%
		displayFolder: Prediction coverage
		lineageTag: 5b1d7bd7-5f0b-43e7-ba28-065f1938bdee

	/// High Risk Customers
	measure 'High Risk Customers' = CALCULATE([Scored Customers], KEEPFILTERS(Customers[Risk Band] = "High"))
		formatString: #,0
		displayFolder: Risk
		lineageTag: eb795be7-cb3d-493b-aad6-2f14770f00e3

	/// Existing saved model probability, blank for customers without a score. In a customer row this is that customer's score.
	measure 'Predicted Churn Probability' = MAX(Customers[ChurnProbability])
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: 45a6f9f2-6a03-41f1-a585-41df9afc19e9

	/// Average Churn Probability
	measure 'Average Churn Probability' = AVERAGE(Customers[ChurnProbability])
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: db908b16-8753-4299-bb63-8fbe9431b88a

	/// Customer Monthly Charges
	measure 'Customer Monthly Charges' = IF(HASONEVALUE(Customers[customerID]), MAX(Customers[MonthlyCharges]))
		formatString: #,0.00
		displayFolder: Risk
		lineageTag: 17d72566-22e0-439b-920f-79c18d3ca3c5

	/// Customer Tenure Months
	measure 'Customer Tenure Months' = IF(HASONEVALUE(Customers[customerID]), MAX(Customers[tenure]))
		formatString: 0
		displayFolder: Risk
		lineageTag: 26ea5082-6088-4d08-b5ff-b4f4d092f888

	/// Exactly ten scored customers at most, ordered by probability then customer ID to resolve ties.
	measure 'Top 10 Churn Probability' =
			VAR Candidates = FILTER(ALLSELECTED(Customers[customerID]), NOT ISBLANK(CALCULATE([Predicted Churn Probability])))
			VAR TopCustomers = TOPN(10, Candidates, [Predicted Churn Probability], DESC, Customers[customerID], ASC)
			RETURN IF(HASONEVALUE(Customers[customerID]) && CONTAINS(TopCustomers, Customers[customerID], SELECTEDVALUE(Customers[customerID])), [Predicted Churn Probability])
		formatString: 0.00%
		displayFolder: Risk
		lineageTag: 90bef4ce-2423-4473-a578-cfa47604b5f4

	/// Service Customers
	measure 'Service Customers' = DISTINCTCOUNT(CustomerServices[customerID])
		formatString: #,0
		displayFolder: Service analysis
		lineageTag: cdb0e6e8-8a62-406a-b79e-80588daef0a4

	/// Service Churned Customers
	measure 'Service Churned Customers' = CALCULATE([Service Customers], KEEPFILTERS(Customers[Churn] = "Yes"))
		formatString: #,0
		displayFolder: Service analysis
		lineageTag: 16a9d53a-63ff-4b59-9018-df05faf784b0

	/// Service Churn Rate
	measure 'Service Churn Rate' = DIVIDE([Service Churned Customers], [Service Customers])
		formatString: 0.00%
		displayFolder: Service analysis
		lineageTag: 953cddf9-5030-41d3-afec-0da37bb29a6d

